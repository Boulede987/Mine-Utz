@startuml ConflictExplainer

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace com.mineutze.worldgen.plan {
class ConflictExplainer {
  - model : CountingModel
  - timeLimit : Duration
  - {static} recordAndSetAside(LawConflict, List<LawConflict>, List<GraphLaw>)
  - {static} biomesOf(List<GraphLaw>) : List<BiomeId>
  - {static} concerns(GraphLaw, BiomeId) : boolean
  - {static} union(List<GraphLaw>, List<GraphLaw>) : List<GraphLaw>
}
class Explanation <<record>> {
  + conflicts : LawConflict[*]
  + complete : boolean
}
class Run {
  - deadlineNanos : long
  - minimalConflict(List<GraphLaw>, Predicate<List<GraphLaw>>) : List<GraphLaw>
  - shrinkOnFullModel(List<GraphLaw>) : List<GraphLaw>
  - dropIfStillContradicting(List<GraphLaw>, GraphLaw)
  - quickXplain(List<GraphLaw>, boolean, List<GraphLaw>, Predicate<List<GraphLaw>>) : List<GraphLaw>
  - contradicts(List<GraphLaw>) : boolean
  - contradicts(List<GraphLaw>, BiomeId) : boolean
  - requireTimeLeft()
}
class Incomplete <<static>> {
}
}

com.mineutze.worldgen.plan.Incomplete --|> RuntimeException
com.mineutze.worldgen.plan.Explanation *--> "0..*" com.mineutze.worldgen.plan.LawConflict

@enduml