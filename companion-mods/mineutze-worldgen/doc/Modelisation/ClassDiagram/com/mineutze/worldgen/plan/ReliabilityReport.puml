@startuml ReliabilityReport

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace com.mineutze.worldgen.plan {
class ReliabilityReport <<record>> {
  + verdict : ReliabilityVerdict
  + estimate : ReliabilityEstimate
  + evidence : Evidence
  + tightness : StageTightness
  + targetWorldFailure : double
  + elapsed : Duration
  - {static} MILLIS_PER_SECOND : double
  + summary() : String
  ~ {static} rangeLine(ReliabilityEstimate, double, ReliabilityVerdict) : String
}
}

com.mineutze.worldgen.plan.ReliabilityReport *--> com.mineutze.worldgen.plan.Evidence
com.mineutze.worldgen.plan.ReliabilityReport *--> com.mineutze.worldgen.plan.ReliabilityEstimate
com.mineutze.worldgen.plan.ReliabilityReport *--> com.mineutze.worldgen.plan.ReliabilityVerdict
com.mineutze.worldgen.plan.ReliabilityReport *--> com.mineutze.worldgen.plan.StageTightness

@enduml