namespace com.mineutze.worldgen.plan {
class IndependentAttemptPool<T> {
  - executor : ExecutorService
  - completions : CompletionService<T>
  - running : int
  + close()
  - {static} daemonThread(Runnable) : Thread
  - pollFor(Duration) : Future<T>
  - {static} resultOf(Future<R>) : R
}
}

com.mineutze.worldgen.plan.IndependentAttemptPool ..|> AutoCloseable