@startuml PlanSettings

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace com.mineutze.worldgen.plan {
class PlanSettings <<record>> {
  + gridSize : int
  + atomWidthBlocks : double
  + perimeterRatio : double
  + warpStrengthsStrongestFirst : double[*]
  + rasterSamplesPerSide : int
  + sizeToleranceOfMinimum : double
  + patternStepsPerAttempt : long
  + maxPatternAttempts : int
  + patternSchedule : ToroidalSizedLocalSearch.Schedule
  + fineResolution : FineResolution
}
class FineResolution <<record>> {
  + gridSize : int
  + atomWidthBlocks : double
  + refinementStepsPerAttempt : long
  + maxRefinementAttempts : int
  + refinementSchedule : ToroidalSizedLocalSearch.Schedule
  + shapeFloorRatios : Map<BiomeId, Double>
}
}

com.mineutze.worldgen.plan.PlanSettings *--> com.mineutze.worldgen.plan.FineResolution
com.mineutze.worldgen.plan.PlanSettings *--> com.mineutze.worldgen.plan.Schedule
com.mineutze.worldgen.plan.PlanSettings *--> com.mineutze.worldgen.plan.ToroidalSizedLocalSearch
com.mineutze.worldgen.plan.FineResolution *--> com.mineutze.worldgen.biomegraph.BiomeId
com.mineutze.worldgen.plan.FineResolution *--> com.mineutze.worldgen.plan.Schedule
com.mineutze.worldgen.plan.FineResolution *--> com.mineutze.worldgen.plan.ToroidalSizedLocalSearch

@enduml