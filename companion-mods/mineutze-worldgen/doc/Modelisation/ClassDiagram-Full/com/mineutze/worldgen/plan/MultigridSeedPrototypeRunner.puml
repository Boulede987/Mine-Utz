@startuml MultigridSeedPrototypeRunner

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace com.mineutze.worldgen.plan {
class MultigridSeedPrototypeRunner {
  - {static} COARSE_GRID_SIZE : int
  - {static} COARSE_ATOM_WIDTH_BLOCKS : double
  - {static} FINE_GRID_SIZE : int
  - {static} FINE_ATOM_WIDTH_BLOCKS : double
  - {static} AGGREGATION_FACTOR : int
  - {static} REFINEMENT_STEPS : long
  - {static} MAX_REFINEMENT_ATTEMPTS : int
  - {static} REFINEMENT_SCHEDULE : ToroidalSizedLocalSearch.Schedule
  - {static} OUTPUT_DIRECTORY : Path
  - {static} BEACH : BiomeId
  - {static} BEACH_FLOOR_RATIO : double
  + {static} main(String[])
  - {static} runSeed(RawRuleTable, ToroidalGrid, ToroidalGrid, ClusterSizeModel, ClusterSizeModel, long, int) : SeedResult
  - {static} exportPictures(RawRuleTable, ToroidalGrid, ToroidalGrid, long, Map<ToroidalPos, BiomeId>, Map<ToroidalPos, BiomeId>, Map<ToroidalPos, BiomeId>)
  - {static} exportBeachZoom(ToroidalGrid, Map<ToroidalPos, BiomeId>, Path, long)
  - {static} beachClustersOf(ToroidalGrid, Map<ToroidalPos, BiomeId>) : List<List<ToroidalPos>>
  - {static} tightestBoundingBoxCluster(List<List<ToroidalPos>>) : List<ToroidalPos>
  - {static} boundingBoxArea(List<ToroidalPos>) : long
  - {static} pixelBounds(List<ToroidalPos>) : int[]
  - {static} exportCrop(Path, List<ToroidalPos>, Path)
  - {static} refineWithRetries(RawRuleTable, ToroidalGrid, ClusterSizeModel, long, Map<ToroidalPos, BiomeId>) : RefinementOutcome
  - {static} upsampleToFineSeed(ToroidalGrid, ToroidalGrid, Map<ToroidalPos, BiomeId>) : Map<ToroidalPos, BiomeId>
  - {static} assignUpsampledCell(Map<ToroidalPos, BiomeId>, ToroidalGrid, Map<ToroidalPos, BiomeId>, ToroidalPos)
  - {static} reportSummary(List<SeedResult>)
  - {static} reportSeedLine(SeedResult)
  - {static} coarseModel(RawRuleTable) : ClusterSizeModel
  - {static} fineModel(RawRuleTable) : ClusterSizeModel
  - {static} secondsSince(long) : double
}
class RefinementOutcome <<record>> {
  + solved : boolean
  + attemptsUsed : int
  + bestCost : int
  + assignment : Map<ToroidalPos, BiomeId>
}
class SeedResult <<record>> {
  + worldSeed : long
  + coarseSeconds : double
  + seededCost : int
  + refinement : RefinementOutcome
  + refineSeconds : double
}
}

com.mineutze.worldgen.plan.RefinementOutcome *--> com.mineutze.worldgen.biomegraph.BiomeId
com.mineutze.worldgen.plan.RefinementOutcome *--> com.mineutze.worldgen.plan.ToroidalPos
com.mineutze.worldgen.plan.SeedResult *--> com.mineutze.worldgen.plan.RefinementOutcome
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.biomegraph.BiomeGraphData
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.biomegraph.BiomeGraphJson
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.biomegraph.BiomeId
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.ClusterSizeModel
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.PatternClusters
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.PlanSettings
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.RawRuleTable
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.RefinementOutcome
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.SeedResult
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.ShapeRule
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.ToroidalGrid
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.ToroidalPatternPngExporter
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.ToroidalPos
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.ToroidalSizedLocalSearch
com.mineutze.worldgen.plan.MultigridSeedPrototypeRunner ..> com.mineutze.worldgen.plan.ToroidalSizedPatternGenerator

@enduml