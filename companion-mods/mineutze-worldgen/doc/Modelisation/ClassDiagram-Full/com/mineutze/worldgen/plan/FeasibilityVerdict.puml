@startuml FeasibilityVerdict

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace com.mineutze.worldgen.plan {
class FeasibilityVerdict <<record>> {
  + outcome : Outcome
  + proof : Optional<InfeasibilityProof>
  + builtWorld : Optional<BuiltWorld>
  + evidence : Evidence
  + reliability : Optional<ReliabilityEstimate>
  + targetWorldFailure : double
  + elapsed : Duration
  - {static} PERCENT_PER_UNIT : double
  - {static} SMALLEST_SHOWN_PERCENT : double
  - {static} MILLIS_PER_SECOND : double
  ~ {static} infeasible(InfeasibilityProof, Evidence, double, Duration) : FeasibilityVerdict
  ~ {static} feasible(BuiltWorld, Evidence, ReliabilityEstimate, double, Duration) : FeasibilityVerdict
  ~ {static} unproven(Evidence, double, Duration) : FeasibilityVerdict
  + summary() : String
  - feasibleSummary() : String
  - {static} infeasibleSummary(InfeasibilityProof) : String
  - {static} appendConflict(StringBuilder, int, LawConflict)
  - unprovenSummary() : String
  - attemptsLine() : String
  - reliabilityLine() : String
  - seconds() : String
  - {static} percent(double) : String
}
enum Outcome <<enum>> {
  FEASIBLE
  INFEASIBLE
  UNPROVEN
}
}

com.mineutze.worldgen.plan.FeasibilityVerdict *--> com.mineutze.worldgen.plan.BuiltWorld
com.mineutze.worldgen.plan.FeasibilityVerdict *--> com.mineutze.worldgen.plan.Evidence
com.mineutze.worldgen.plan.FeasibilityVerdict *--> com.mineutze.worldgen.plan.InfeasibilityProof
com.mineutze.worldgen.plan.FeasibilityVerdict *--> com.mineutze.worldgen.plan.Outcome
com.mineutze.worldgen.plan.FeasibilityVerdict *--> com.mineutze.worldgen.plan.ReliabilityEstimate
com.mineutze.worldgen.plan.FeasibilityVerdict ..> com.mineutze.worldgen.plan.LawConflict

@enduml