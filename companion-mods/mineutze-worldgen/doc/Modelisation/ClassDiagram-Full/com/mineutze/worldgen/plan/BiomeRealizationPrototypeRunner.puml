  - {static} readPattern(Path, ToroidalGrid) : Map<ToroidalPos, BiomeId>
  - {static} parsePatternLine(Map<ToroidalPos, BiomeId>, String)
}
class Preset <<record>> {
  + name : String
  + settings : DivergenceFreeWarp.Settings
}
}

