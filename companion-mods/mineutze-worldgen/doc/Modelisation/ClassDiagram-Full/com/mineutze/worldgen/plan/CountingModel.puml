@startuml CountingModel

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace com.mineutze.worldgen.plan {
class CountingModel {
  - {static} CHECK_TIME_LIMIT : Duration
  - {static} EDGES_PER_CELL : int
  - biomes : BiomeId[*]
  - indexOfBiome : Map<BiomeId, Integer>
  - minCells : int[*]
  - maxCells : int[*]
  - perimeterCeilingPerPatch : int[*]
  - gridSide : int
  - gridCells : int
  ~ {static} of(RawRuleTable, PlanSettings) : CountingModel
  - {static} solve(Model) : CountingStatus
  - indexOf(BiomeId) : int
  - {static} alternativesOf(ResolvedBorderRequirement) : List<ResolvedBorderRequirement.Share>
}
class Build {
  - model : Model
  - count : int
  - sized : boolean[*]
  - forbidden : boolean[][*]
  - requirements : RequiredBorderLaw[*]
  - patches : IntVar[*]
  - cells : IntVar[*]
  - perimeter : IntVar[*]
  - edges : IntVar[][*]
  - modelled : boolean[*]
  - everyBiomeModelled : boolean
  - {static} allTrue(boolean[]) : boolean
  - outerGridCells() : int
  - pairModelled(int, int) : boolean
  - classify(GraphLaw)
  - markForbidden(int, int)
  - declarePatchesAndCells()
  - declareEdgesAndPerimeters()
  - postPerimeterIdentity(int)
  - postSizeAndPerimeterBounds(int)
  - postIllegalPairs()
  - postRequirement(RequiredBorderLaw)
  - postRequirementPart(int, ResolvedBorderRequirement)
  - postShares(int, List<ResolvedBorderRequirement.Share>)
  - postWeightedShares(int, List<ResolvedBorderRequirement.Share>, ShareWeights)
  - addShareTerms(int, ResolvedBorderRequirement.Share, int, List<IntVar>, List<Integer>)
}
class Corners <<record>> {
  + build : Build
  - hasLegalThird(int, int) : boolean
  - postSegments(int, int, List<IntVar>[]) : IntVar
  - postPatchVertices(int, IntVar[], List<IntVar>)
  - {static} newLists(int) : List<IntVar>[]
}
}

com.mineutze.worldgen.plan.Corners *--> com.mineutze.worldgen.plan.Build
com.mineutze.worldgen.plan.CountingModel --> "0..*" com.mineutze.worldgen.biomegraph.BiomeId
com.mineutze.worldgen.plan.CountingModel ..> com.mineutze.worldgen.plan.Build
com.mineutze.worldgen.plan.CountingModel ..> com.mineutze.worldgen.plan.ClusterSizeModel
com.mineutze.worldgen.plan.CountingModel ..> com.mineutze.worldgen.plan.CountingStatus
com.mineutze.worldgen.plan.CountingModel ..> com.mineutze.worldgen.plan.MultigridPatternGenerator
com.mineutze.worldgen.plan.CountingModel ..> com.mineutze.worldgen.plan.PlanSettings
com.mineutze.worldgen.plan.CountingModel ..> com.mineutze.worldgen.plan.RawRuleTable
com.mineutze.worldgen.plan.CountingModel ..> com.mineutze.worldgen.plan.ResolvedBorderRequirement
com.mineutze.worldgen.plan.CountingModel ..> com.mineutze.worldgen.plan.Share
com.mineutze.worldgen.plan.Build ..> com.mineutze.worldgen.plan.Corners
com.mineutze.worldgen.plan.Build ..> com.mineutze.worldgen.plan.GraphLaw
com.mineutze.worldgen.plan.Build ..> com.mineutze.worldgen.plan.RequiredBorderLaw
com.mineutze.worldgen.plan.Build ..> com.mineutze.worldgen.plan.ResolvedBorderRequirement
com.mineutze.worldgen.plan.Build ..> com.mineutze.worldgen.plan.ShapeRule
com.mineutze.worldgen.plan.Build ..> com.mineutze.worldgen.plan.Share
com.mineutze.worldgen.plan.Build ..> com.mineutze.worldgen.plan.ShareWeights

@enduml