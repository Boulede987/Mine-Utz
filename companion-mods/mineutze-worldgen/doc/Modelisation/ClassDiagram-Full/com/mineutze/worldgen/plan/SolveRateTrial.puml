@startuml SolveRateTrial

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace com.mineutze.worldgen.plan {
class SolveRateTrial {
  ~ {static} BASELINE_LABEL : String
  - {static} TRIAL_WORLD_SEED : long
  - settings : PlanSettings
  - threads : int
  - wallTime : Duration
  - boundConfidence : double
  ~ {static} improves(double, double) : boolean
  - resultsOf(Arm, List<Arm>) : List<ArmResult>
  - resultOf(Arm, boolean, double) : ArmResult
}
class Arm <<static>> {
  - label : String
  - stages : Optional<SolveStages>
  - rejection : Optional<String>
  - evidence : StageEvidence
  - submitted : int
  ~ {static} of(String, BiomeGraphData, PlanSettings) : Arm
}
class AttemptOutcome <<record>> {
  + arm : Arm
  + solved : boolean
  + cost : int
  + durationNanos : long
}
class Run {
  - runnable : Arm[*]
  - deadlineNanos : long
  - baseSeed : long
  - stopRequested : AtomicBoolean
  - pool : IndependentAttemptPool<AttemptOutcome>
  - longestAttemptNanos : long
  - nextArmToTry : int
  - awaitOne(WorldBiomePlan.ProgressListener) : boolean
  - startingAnotherFitsBeforeDeadline() : boolean
  - submitNext()
  - leastSubmitted() : Arm
  - attempt(Arm, long) : AttemptOutcome
  + close()
}
}

com.mineutze.worldgen.plan.Run ..|> AutoCloseable
com.mineutze.worldgen.plan.AttemptOutcome *--> com.mineutze.worldgen.plan.Arm
com.mineutze.worldgen.plan.SolveRateTrial --> com.mineutze.worldgen.plan.PlanSettings
com.mineutze.worldgen.plan.SolveRateTrial ..> com.mineutze.worldgen.plan.Arm
com.mineutze.worldgen.plan.SolveRateTrial ..> com.mineutze.worldgen.plan.ArmResult
com.mineutze.worldgen.plan.SolveRateTrial ..> com.mineutze.worldgen.plan.BinomialConfidence
com.mineutze.worldgen.plan.SolveRateTrial ..> com.mineutze.worldgen.plan.Run
com.mineutze.worldgen.plan.SolveRateTrial ..> com.mineutze.worldgen.plan.StageEvidence
com.mineutze.worldgen.plan.Arm --> com.mineutze.worldgen.plan.SolveStages
com.mineutze.worldgen.plan.Arm --> com.mineutze.worldgen.plan.StageEvidence
com.mineutze.worldgen.plan.Arm ..> com.mineutze.worldgen.biomegraph.BiomeGraphData
com.mineutze.worldgen.plan.Arm ..> com.mineutze.worldgen.plan.CatalogRejected
com.mineutze.worldgen.plan.Arm ..> com.mineutze.worldgen.plan.PlanSettings
com.mineutze.worldgen.plan.Run --> "0..*" com.mineutze.worldgen.plan.Arm
com.mineutze.worldgen.plan.Run ..> com.mineutze.worldgen.plan.AttemptOutcome
com.mineutze.worldgen.plan.Run ..> com.mineutze.worldgen.plan.ProgressListener
com.mineutze.worldgen.plan.Run ..> com.mineutze.worldgen.plan.SolveStages
com.mineutze.worldgen.plan.Run ..> com.mineutze.worldgen.plan.ToroidalSizedLocalSearch
com.mineutze.worldgen.plan.Run ..> com.mineutze.worldgen.plan.WorldBiomePlan

@enduml