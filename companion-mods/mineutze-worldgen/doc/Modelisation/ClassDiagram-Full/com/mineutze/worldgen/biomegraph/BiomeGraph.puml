@startuml BiomeGraph

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace com.mineutze.worldgen.biomegraph {
class BiomeGraph {
  - nodesById : Map<BiomeId, BiomeNode>
  - rulesByPair : Map<UnorderedBiomePair, AdjacencyRule>
  - {static} MIN_LEGAL_NEIGHBORS : int
  + {static} forProduction(Collection<BiomeNode>, Collection<AdjacencyRule>) : BiomeGraph
  + requireMinLegalNeighbors() : BiomeGraph
  - validateBiomeNeighbors(BiomeId)
  - {static} indexNodes(Collection<BiomeNode>) : Map<BiomeId, BiomeNode>
  - {static} indexNode(Map<BiomeId, BiomeNode>, BiomeNode)
  - {static} indexRules(Collection<AdjacencyRule>) : Map<UnorderedBiomePair, AdjacencyRule>
  - {static} indexRule(Map<UnorderedBiomePair, AdjacencyRule>, AdjacencyRule)
  - requireAllRuleNodesKnown()
  - validatePairNodesKnown(UnorderedBiomePair)
  - requireKnownNode(BiomeId)
  + node(BiomeId) : BiomeNode
  + nodes() : Collection<BiomeNode>
  + isAllowed(BiomeId, BiomeId) : boolean
  + rule(BiomeId, BiomeId) : AdjacencyRule
}
}

com.mineutze.worldgen.biomegraph.BiomeGraph --> com.mineutze.worldgen.biomegraph.AdjacencyRule
com.mineutze.worldgen.biomegraph.BiomeGraph --> com.mineutze.worldgen.biomegraph.BiomeId
com.mineutze.worldgen.biomegraph.BiomeGraph --> com.mineutze.worldgen.biomegraph.BiomeNode
com.mineutze.worldgen.biomegraph.BiomeGraph --> com.mineutze.worldgen.biomegraph.UnorderedBiomePair

@enduml