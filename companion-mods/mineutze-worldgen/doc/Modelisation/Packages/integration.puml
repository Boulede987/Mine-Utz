@startuml integration

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

skinparam class {
  BackgroundColor<<external>> #EAECEE
  BorderColor<<external>> #839192
}

class BiomeIdAdapter {
  + {static} toBiomeId(ResourceLocation) : BiomeId
  + {static} toResourceLocation(BiomeId) : ResourceLocation
}
class BiomeShapeOffsetDensityFunction <<record>> {
  + {static} CODEC : MapCodec<BiomeShapeOffsetDensityFunction>
  - {static} KEY_DISPATCH_CODEC : KeyDispatchDataCodec<BiomeShapeOffsetDensityFunction>
  - {static} VERTICAL_SHIFT_AMPLITUDE : double
  - {static} WAVE_AMPLITUDE : double
  - {static} WAVELENGTH_BLOCKS : double
  - {static} WAVE_FREQUENCY : double
  - {static} TOP_FADE_START_Y : int
  - {static} TOP_FADE_END_Y : int
  - {static} BOTTOM_FADE_START_Y : int
  - {static} BOTTOM_FADE_END_Y : int
  - {static} LOGGER : Logger
  - {static} LOGGED_CELLS : MacroCellPos[*]
  - {static} MAX_LOGGED_CELLS : int
  + compute(FunctionContext) : double
  - {static} baseOffsetForBiome(BiomeId, double) : double
  - {static} logIfNewCell(FunctionContext, double)
  - {static} verticalFade(int) : double
  + minValue() : double
  + maxValue() : double
  + codec() : KeyDispatchDataCodec<? extends DensityFunction>
}
class ModBiomeSources {
  + {static} CUSTOM_OVERWORLD_ID : String
  + {static} register(RegisterEvent)
}
class ModDensityFunctionTypes {
  + {static} BIOME_SHAPE_OFFSET_ID : String
  + {static} register(RegisterEvent)
}
class ModOverworldBiomeSource {
  + {static} CODEC : MapCodec<ModOverworldBiomeSource>
  - biomesById : Map<ResourceLocation, Holder<Biome>>
  # collectPossibleBiomes() : Stream<Holder<Biome>>
  # codec() : MapCodec<? extends BiomeSource>
  + getNoiseBiome(int, int, int, Climate.Sampler) : Holder<Biome>
}
class RegionCacheHolder {
  - {static} LOGGER : Logger
  - {static} READY_TIMEOUT_SECONDS : long
  - {static} MAX_CACHED_REGIONS : int
  - {static} READY : CountDownLatch
  - {static} current : SeedRegionCache
  + {static} onLevelLoad(LevelEvent.Load)
  + {static} get() : SeedRegionCache
  - {static} awaitReady()
  - {static} logRegionSolved(RegionPos, RegionSolveResult, long)
}
class RegionDebugCommand {
  - {static} SERVER_OPERATOR_PERMISSION_LEVEL : int
  - {static} DEFAULT_EXPORT_REGION_SPAN : int
  - {static} MAX_EXPORT_REGION_SPAN : int
  + {static} register(RegisterCommandsEvent)
  - {static} solveRegionAtSource(CommandContext<CommandSourceStack>) : int
  - {static} exportBiomes(CommandContext<CommandSourceStack>, int) : int
  - {static} countByBiome(Map<MacroCellPos, BiomeId>) : Map<BiomeId, Long>
}
class SavedDataRegionPersistenceStore {
  - level : ServerLevel
  + load(RegionPos) : Optional<RegionSolveResult>
  + save(RegionPos, RegionSolveResult)
  - {static} saveName(RegionPos) : String
}
class RegionCacheData <<static>> {
  - {static} SCHEMA_VERSION : int
  - {static} SCHEMA_VERSION_KEY : String
  - {static} DROPPED_DEMAND_COUNT_KEY : String
  - {static} WARNINGS_KEY : String
  - {static} WARNING_KEY : String
  - {static} CELLS_KEY : String
  - {static} CELL_X_KEY : String
  - {static} CELL_Z_KEY : String
  - {static} CELL_BIOME_KEY : String
  - result : RegionSolveResult
  ~ {static} from(RegionSolveResult) : RegionCacheData
  + save(CompoundTag, HolderLookup.Provider) : CompoundTag
  ~ {static} load(CompoundTag, HolderLookup.Provider) : RegionCacheData
}
class WorldBiomeExporter {
  - {static} OUTPUT_DIR_NAME : String
  ~ {static} exportAroundPosition(ServerLevel, Vec3, int) : Result
  - {static} sampleBiomeAt(ServerLevel, MacroGridConfig, MacroCellPos) : BiomeId
  - {static} createOutputDir(Path)
}
class Result <<record>> {
  + outputDir : Path
  + cellsExported : int
}
class AsciiExporter <<external>> [[export.svg]] {
}
class BiomeId <<external>> [[biomegraph.svg]] {
}
class BiomeLegend <<external>> [[export.svg]] {
}
class BiomeShapeHints <<external>> [[biomegraph.svg]] {
}
class BorderBlend <<external>> [[regionsolve.svg]] {
}
class ExportSnapshot <<external>> [[export.svg]] {
}
class JsonExporter <<external>> [[export.svg]] {
}
class MacroCellPos <<external>> [[regionsolve.svg]] {
}
class MacroGridConfig <<external>> [[regionsolve.svg]] {
}
class ModBiomeGraph <<external>> [[biomegraph.svg]] {
}
class PngExporter <<external>> [[export.svg]] {
}
class RegionPersistenceStore <<external>> [[regionsolve.svg]] {
}
class RegionPos <<external>> [[regionsolve.svg]] {
}
class RegionSolveResult <<external>> [[regionsolve.svg]] {
}
class SeedRegionCache <<external>> [[regionsolve.svg]] {
}
class WorldgenMod <<external>> [[worldgen.svg]] {
}

BiomeIdAdapter ..> BiomeId
BiomeShapeOffsetDensityFunction ..|> DensityFunction.SimpleFunction
BiomeShapeOffsetDensityFunction ..> BiomeId
BiomeShapeOffsetDensityFunction ..> BiomeShapeHints
BiomeShapeOffsetDensityFunction ..> BorderBlend
BiomeShapeOffsetDensityFunction ..> MacroCellPos
BiomeShapeOffsetDensityFunction ..> MacroGridConfig
BiomeShapeOffsetDensityFunction ..> ModBiomeGraph
BiomeShapeOffsetDensityFunction ..> RegionCacheHolder
ModBiomeSources ..> ModOverworldBiomeSource
ModBiomeSources ..> WorldgenMod
ModDensityFunctionTypes ..> BiomeShapeOffsetDensityFunction
ModDensityFunctionTypes ..> WorldgenMod
ModOverworldBiomeSource --|> BiomeSource
ModOverworldBiomeSource ..> BiomeId
ModOverworldBiomeSource ..> BiomeIdAdapter
ModOverworldBiomeSource ..> MacroCellPos
ModOverworldBiomeSource ..> MacroGridConfig
ModOverworldBiomeSource ..> RegionCacheHolder
RegionCacheHolder *--> SeedRegionCache
RegionCacheHolder ..> MacroGridConfig
RegionCacheHolder ..> ModBiomeGraph
RegionCacheHolder ..> RegionPos
RegionCacheHolder ..> RegionSolveResult
RegionCacheHolder ..> SavedDataRegionPersistenceStore
RegionDebugCommand ..> BiomeId
RegionDebugCommand ..> MacroCellPos
RegionDebugCommand ..> MacroGridConfig
RegionDebugCommand ..> RegionCacheHolder
RegionDebugCommand ..> RegionPos
RegionDebugCommand ..> RegionSolveResult
RegionDebugCommand ..> WorldBiomeExporter
SavedDataRegionPersistenceStore ..|> RegionPersistenceStore
RegionCacheData --|> SavedData
RegionCacheData *--> RegionSolveResult
SavedDataRegionPersistenceStore ..> RegionCacheData
SavedDataRegionPersistenceStore ..> RegionPos
SavedDataRegionPersistenceStore ..> RegionSolveResult
RegionCacheData ..> BiomeId
RegionCacheData ..> BiomeIdAdapter
RegionCacheData ..> MacroCellPos
WorldBiomeExporter ..> AsciiExporter
WorldBiomeExporter ..> BiomeId
WorldBiomeExporter ..> BiomeIdAdapter
WorldBiomeExporter ..> BiomeLegend
WorldBiomeExporter ..> ExportSnapshot
WorldBiomeExporter ..> JsonExporter
WorldBiomeExporter ..> MacroCellPos
WorldBiomeExporter ..> MacroGridConfig
WorldBiomeExporter ..> ModBiomeGraph
WorldBiomeExporter ..> PngExporter
WorldBiomeExporter ..> RegionPos
WorldBiomeExporter ..> Result

