@startuml regionsolve

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

skinparam class {
  BackgroundColor<<external>> #EAECEE
  BorderColor<<external>> #839192
}

class BorderBlend {
  + {static} blendedValue(int, int, MacroGridConfig, BiomeGraph, Function<MacroCellPos, BiomeId>, ToDoubleFunction<BiomeId>) : double
  - {static} blendFactor(int, int, int, BiomeId, BiomeId, BiomeGraph) : double
  - {static} lerp(double, double, double) : double
}
class ConnectedComponents {
  ~ {static} find(Map<MacroCellPos, BiomeId>, Set<MacroCellPos>) : List<Set<MacroCellPos>>
}
class GrowthEngine {
  ~ {static} satisfiesCohesion(MacroCellPos, BiomeId, Map<MacroCellPos, BiomeId>, GrowthCohesionProfile) : boolean
  - {static} satisfiesDirectionalRun(MacroCellPos, BiomeId, Map<MacroCellPos, BiomeId>, GrowthCohesionProfile) : boolean
  - {static} contiguousRun(MacroCellPos, BiomeId, Map<MacroCellPos, BiomeId>, int, int) : int
  ~ {static} isLegal(MacroCellPos, BiomeId, Map<MacroCellPos, BiomeId>, BiomeGraph) : boolean
}
class MacroCellPos <<record>> {
  + x : int
  + z : int
  + orthogonalNeighbors() : List<MacroCellPos>
  + diagonalNeighbors() : List<MacroCellPos>
  + distanceSquaredTo(MacroCellPos) : long
  + hashCode() : int
}
class MacroGridConfig <<record>> {
  + macroCellSizeBlocks : int
  + regionSizeCellsPerSide : int
  + {static} DEFAULT : MacroGridConfig
  - {static} WARP_AMPLITUDE_CELLS_CAP : double
  - {static} WARP_AMPLITUDE_FRACTION : double
  - {static} WARP_WAVELENGTH_CELLS : double
  - {static} WARP_OCTAVE_COUNT : int
  - {static} WARP_LACUNARITY : double
  - {static} WARP_PERSISTENCE : double
  - {static} WARP_OCTAVE_AMPLITUDE_NORMALIZER : double
  - {static} WARP_SALT_X : long
  - {static} WARP_SALT_Z : long
  - {static} WARP_MIN_REGION_SIZE : int
  - {static} PAINT_CELL_RATIO : int
  + regionOf(MacroCellPos, long) : RegionPos
  - warpAmplitudeCells() : double
  - warpOffset(int, long, long) : double
  - {static} octavePhase(long, long, int) : double
  - {static} octaveAmplitudeNormalizer() : double
  + warpMarginCells() : int
  + cellsInRegion(RegionPos, long) : List<MacroCellPos>
  + cellCountForWidthBlocks(int) : int
  + paintCellSizeBlocks() : int
}
class PaintCellPos <<record>> {
  + x : int
  + z : int
  + {static} of(MacroCellPos, int) : PaintCellPos
  + orthogonalNeighbors() : List<PaintCellPos>
  + diagonalNeighbors() : List<PaintCellPos>
  + hashCode() : int
}
class PatchSizeEnforcer {
  - {static} MAX_PASSES : int
  + {static} enforceMinimumPatchSize(Map<MacroCellPos, BiomeId>, Set<MacroCellPos>, MacroGridConfig, BiomeGraph)
  - {static} absorbUndersizedComponentsOnce(Map<MacroCellPos, BiomeId>, Set<MacroCellPos>, MacroGridConfig, BiomeGraph) : PassResult
  - {static} bestMergeTarget(Set<MacroCellPos>, BiomeId, Map<MacroCellPos, BiomeId>, Map<MacroCellPos, Integer>, BiomeGraph) : Optional<BiomeId>
  - {static} isLegalForWholeComponent(Set<MacroCellPos>, BiomeId, Map<MacroCellPos, BiomeId>, BiomeGraph) : boolean
}
class PassResult <<record>> {
  + componentCount : int
  + undersizedCount : int
  + mergeCount : int
  + widenCount : int
  + changedAny : boolean
}
class PixelFragmentRepair {
  - {static} MAX_REPAIR_PASSES : int
  - {static} SMALL_FRAGMENT_MAX_SIZE : int
  + {static} repair(Map<MacroCellPos, BiomeId>, Map<MacroCellPos, BiomeId>, BiomeGraph) : Map<MacroCellPos, BiomeId>
  - {static} findIllegalCells(Map<MacroCellPos, BiomeId>, Map<MacroCellPos, BiomeId>, BiomeGraph) : List<MacroCellPos>
  - {static} findSmallFragmentComponents(Map<MacroCellPos, BiomeId>, Map<MacroCellPos, BiomeId>) : List<Set<MacroCellPos>>
  - {static} sameBiomeComponent(MacroCellPos, Map<MacroCellPos, BiomeId>) : Set<MacroCellPos>
  - {static} bestLegalReplacement(MacroCellPos, Map<MacroCellPos, BiomeId>, BiomeGraph) : Optional<BiomeId>
  - {static} bestLegalReplacementForFragment(Set<MacroCellPos>, Map<MacroCellPos, BiomeId>, BiomeGraph) : Optional<BiomeId>
  - {static} fragmentAcceptsCandidate(Set<MacroCellPos>, BiomeId, Map<MacroCellPos, BiomeId>, BiomeGraph) : boolean
  - {static} isLegalIncludingDiagonals(MacroCellPos, BiomeId, Map<MacroCellPos, BiomeId>, BiomeGraph) : boolean
}
class RegionBoundaryCollector {
  + {static} collect(RegionPos, MacroGridConfig, long, Function<RegionPos, Map<MacroCellPos, BiomeId>>) : Map<MacroCellPos, BiomeId>
  + {static} neighborsOf(RegionPos) : List<RegionPos>
  - {static} cellsBorderingRegion(Map<MacroCellPos, BiomeId>, RegionPos, MacroGridConfig, long) : Map<MacroCellPos, BiomeId>
}
interface RegionPersistenceStore <<interface>> {
  + load(RegionPos) : Optional<RegionSolveResult>
  + save(RegionPos, RegionSolveResult) : void
}
class RegionPos <<record>> {
  + x : int
  + z : int
}
class RegionSolveInput <<record>> {
  + graph : BiomeGraph
  + gridConfig : MacroGridConfig
  + region : RegionPos
  + fixedBoundaryCells : Map<MacroCellPos, BiomeId>
  + worldSeed : long
}
class RegionSolveResult <<record>> {
  + assignment : Map<MacroCellPos, BiomeId>
  + warnings : String[*]
  + droppedDemandCount : int
}
class SeedPlacer {
  - {static} JITTER_SALT : long
  + {static} placeSeeds(RegionPos, MacroGridConfig, long, int) : List<MacroCellPos>
  - {static} clampToRegion(int, int, int, int, int) : MacroCellPos
  - {static} jitterSeed(long, int, int) : long
}
class SeedRegionCache {
  - graph : BiomeGraph
  - gridConfig : MacroGridConfig
  - worldSeed : long
  - onRegionSolved : RegionSolveListener
  - persistenceStore : RegionPersistenceStore
  - maxCachedRegions : int
  - solved : Map<RegionPos, RegionSolveResult>
  - lastAccessNanos : Map<RegionPos, Long>
  - solveLock : Object
  + biomeAt(MacroCellPos) : BiomeId
  + resultFor(RegionPos) : RegionSolveResult
  - solve(RegionPos) : RegionSolveResult
  - alreadySolvedAssignment(RegionPos) : Map<MacroCellPos, BiomeId>
  - evictIfOverCapacity()
}
interface RegionSolveListener <<interface>> {
  + onSolved(RegionPos, RegionSolveResult, long) : void
}
class SeparatorWidener {
  ~ {static} STATS : Stats
  ~ {static} widen(Set<MacroCellPos>, BiomeId, int, Map<MacroCellPos, BiomeId>, Set<MacroCellPos>, BiomeGraph, Set<MacroCellPos>)
  - {static} frontierOrder(MacroCellPos, Set<MacroCellPos>) : Comparator<MacroCellPos>
  - {static} minDistanceSquaredTo(MacroCellPos, Set<MacroCellPos>) : long
  - {static} centroidOf(Set<MacroCellPos>) : MacroCellPos
  - {static} addUnclaimedNeighbors(Set<MacroCellPos>, Set<MacroCellPos>, Set<MacroCellPos>, TreeSet<MacroCellPos>)
  - {static} isLegalToClaim(MacroCellPos, BiomeId, Set<MacroCellPos>, Map<MacroCellPos, BiomeId>, BiomeGraph) : boolean
  ~ {static} stealingPreservesDonorConnectivity(MacroCellPos, Map<MacroCellPos, BiomeId>, Set<MacroCellPos>, Set<MacroCellPos>) : boolean
}
class Stats <<static>> {
  + toString() : String
}
class WorldgenTrace {
  - {static} ENABLED : boolean
  + {static} log(String)
}
class BiomeGraph <<external>> [[biomegraph.svg]] {
}
class BiomeId <<external>> [[biomegraph.svg]] {
}
class BiomeNode <<external>> [[biomegraph.svg]] {
}
class GrowthCohesionProfile <<external>> [[biomegraph.svg]] {
}

BorderBlend ..> BiomeGraph
BorderBlend ..> BiomeId
BorderBlend ..> MacroCellPos
BorderBlend ..> MacroGridConfig
ConnectedComponents ..> BiomeId
ConnectedComponents ..> MacroCellPos
GrowthEngine ..> BiomeGraph
GrowthEngine ..> BiomeId
GrowthEngine ..> GrowthCohesionProfile
GrowthEngine ..> MacroCellPos
MacroGridConfig ..> MacroCellPos
MacroGridConfig ..> RegionPos
PaintCellPos ..> MacroCellPos
PatchSizeEnforcer ..> BiomeGraph
PatchSizeEnforcer ..> BiomeId
PatchSizeEnforcer ..> BiomeNode
PatchSizeEnforcer ..> ConnectedComponents
PatchSizeEnforcer ..> MacroCellPos
PatchSizeEnforcer ..> MacroGridConfig
PatchSizeEnforcer ..> PassResult
PatchSizeEnforcer ..> SeparatorWidener
PatchSizeEnforcer ..> WorldgenTrace
PixelFragmentRepair ..> BiomeGraph
PixelFragmentRepair ..> BiomeId
PixelFragmentRepair ..> GrowthEngine
PixelFragmentRepair ..> MacroCellPos
PixelFragmentRepair ..> WorldgenTrace
RegionBoundaryCollector ..> BiomeId
RegionBoundaryCollector ..> MacroCellPos
RegionBoundaryCollector ..> MacroGridConfig
RegionBoundaryCollector ..> RegionPos
RegionSolveInput *--> BiomeGraph
RegionSolveInput *--> BiomeId
RegionSolveInput *--> MacroCellPos
RegionSolveInput *--> MacroGridConfig
RegionSolveInput *--> RegionPos
RegionSolveResult *--> BiomeId
RegionSolveResult *--> MacroCellPos
SeedPlacer ..> MacroCellPos
SeedPlacer ..> MacroGridConfig
SeedPlacer ..> RegionPos
SeedRegionCache --> BiomeGraph
SeedRegionCache --> MacroGridConfig
SeedRegionCache --> RegionPersistenceStore
SeedRegionCache --> RegionSolveListener
SeedRegionCache ..> BiomeId
SeedRegionCache ..> MacroCellPos
SeedRegionCache ..> RegionPos
SeedRegionCache ..> RegionSolveResult
SeparatorWidener ..> BiomeGraph
SeparatorWidener ..> BiomeId
SeparatorWidener ..> MacroCellPos

@enduml