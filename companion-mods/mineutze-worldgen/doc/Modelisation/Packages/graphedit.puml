@startuml graphedit

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

skinparam class {
  BackgroundColor<<external>> #EAECEE
  BorderColor<<external>> #839192
}

namespace com.mineutze.worldgen.tooling.graphedit {
class CurrentRun {
  - current : Optional<GradleRun>
  ~ start(String, List<String>) : Optional<GradleRun>
  ~ current() : Optional<GradleRun>
}
class GradleRun {
  - {static} NEXT_NUMBER : AtomicInteger
  - number : int
  - label : String
  - process : Process
  - lines : String[*]
  - stopped : AtomicBoolean
  - exitCode : OptionalInt
  ~ {static} start(String, List<String>) : GradleRun
  - readUntilExit()
  - copyOutputLines()
  - awaitExit() : int
  - recordFailure(String, Throwable)
}
class GraphEditorFiles {
  ~ {static} DATA_FILE : Path
  ~ {static} VERDICT_WORLD_PICTURE : Path
  ~ {static} TIGHTNESS_RANKING : Path
}
class GraphEditorReliability {
  - {static} EXIT_MET : int
  - {static} EXIT_NOT_MET : int
  - {static} EXIT_UNDECIDED : int
  - {static} EXIT_CRASH : int
  + {static} main(String[])
  ~ {static} requestFrom(String[]) : ReliabilityRequest
  - {static} measureSavedGraph(ReliabilityRequest) : int
  - {static} rankingSavedAfterVerdict(ReliabilityReport, BiomeGraphData) : boolean
}
class GraphEditorServer {
  - {static} DEFAULT_PORT : int
  + {static} main(String[])
}
class GraphEditorSolveCheck {
  - {static} EXIT_FEASIBLE : int
  - {static} EXIT_INFEASIBLE : int
  - {static} EXIT_UNPROVEN : int
  - {static} EXIT_CRASH : int
  + {static} main(String[])
  - {static} checkSavedGraph() : int
  - {static} saveRankingAfterVerdict(FeasibilityVerdict, BiomeGraphData)
  - {static} printVerdict(FeasibilityVerdict)
  - {static} writeWorldPicture(BuiltWorld)
  - {static} exitCodeOf(FeasibilityVerdict.Outcome) : int
}
class GraphEditorVerify {
  - {static} EXIT_NO_RANKING : int
  - {static} EXIT_REFUSED : int
  - {static} EXIT_CRASH : int
  ~ {static} requestFrom(String[]) : Optional<VerifyRequest>
  + {static} main(String[])
  - {static} measure(Optional<VerifyRequest>, BiomeGraphData) : String
}
class GraphValidation {
  - {static} MIN_LEGAL_NEIGHBORS : int
  ~ {static} validate(BiomeGraphData) : ValidationResult
  - {static} generatorRejections(BiomeGraphData) : List<String>
  - {static} underConnectedErrors(BiomeGraph, BiomeGraphData) : List<String>
  - {static} checkConnectivity(BiomeGraph, List<BiomeId>, List<String>, BiomeId)
}
class ValidationResult <<record>> {
  + constructs : boolean
  + constructionError : String
  + errors : String[*]
}
class ReliabilityRequest <<record>> {
  + minutes : int
  - {static} FEWEST_MINUTES : int
  - {static} MOST_MINUTES : int
  - {static} MINUTES_KEY : String
  - {static} GRADLE_ARGS_PREFIX : String
  ~ {static} parse(String) : ReliabilityRequest
  ~ {static} fromArgument(String) : ReliabilityRequest
}
class RunSnapshot <<record>> {
  + runNumber : int
  + label : String
  + newLines : String[*]
  + nextIndex : int
  + exitCode : OptionalInt
  + stopped : boolean
  ~ {static} of(GradleRun, int) : RunSnapshot
}
class RunStatusQuery <<record>> {
  + runNumber : OptionalInt
  + fromIndex : int
  - {static} RUN_KEY : String
  - {static} FROM_KEY : String
  ~ {static} parse(String) : RunStatusQuery
  - {static} numberIn(String[], String) : int
}
class VerifyRequest <<record>> {
  + ranks : Integer[*]
  + fingerprint : String
  - {static} RANKS_KEY : String
  - {static} FINGERPRINT_KEY : String
  - {static} RANK_SEPARATOR : String
  - {static} FINGERPRINT_SEPARATOR : String
  - {static} GRADLE_ARGS_PREFIX : String
  ~ {static} parse(String) : VerifyRequest
  - {static} wholeNumber(Object) : int
  ~ {static} fromArgument(String) : VerifyRequest
  - {static} rankIn(String, String) : int
}
}


@enduml