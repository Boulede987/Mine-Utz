@startuml biomegraph

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

skinparam class {
  BackgroundColor<<external>> #EAECEE
  BorderColor<<external>> #839192
}

class AdjacencyRule <<record>> {
  + biomeA : BiomeId
  + biomeB : BiomeId
  + weight : double
  + blendWidthBlocks : int
  - {static} DEFAULT_WEIGHT : double
  + {static} allow(BiomeId, BiomeId, int) : AdjacencyRule
  + {static} allow(BiomeId, BiomeId, double, int) : AdjacencyRule
}
class BiomeFeatureToggles <<record>> {
  + riversEnabled : boolean
  + lakesEnabled : boolean
}
class BiomeGraph {
  - nodesById : Map<BiomeId, BiomeNode>
  - rulesByPair : Map<UnorderedBiomePair, AdjacencyRule>
  - {static} MAX_BRIDGE_HOPS : int
  - {static} indexNodes(Collection<BiomeNode>) : Map<BiomeId, BiomeNode>
  - {static} indexRules(Collection<AdjacencyRule>) : Map<UnorderedBiomePair, AdjacencyRule>
  - requireAllRuleNodesKnown()
  - requireKnownNode(BiomeId)
  - requireEveryPairBridgeableWithinReassignBudget()
  - shortestHopsFrom(BiomeId) : Map<BiomeId, Integer>
  + node(BiomeId) : BiomeNode
  + nodes() : Collection<BiomeNode>
  + isAllowed(BiomeId, BiomeId) : boolean
  + rule(BiomeId, BiomeId) : AdjacencyRule
}
class BiomeId <<record>> {
  + namespace : String
  + path : String
  + compareTo(BiomeId) : int
  + toString() : String
}
class BiomeNode <<record>> {
  + id : BiomeId
  + sizeRange : BiomeSizeRange
  + shapeHints : BiomeShapeHints
  + featureToggles : BiomeFeatureToggles
  + cohesionProfile : GrowthCohesionProfile
}
class BiomeShapeHints <<record>> {
  + roughness : double
  + depthBias : double
  + flatness : double
  - {static} MIN_HINT_VALUE : double
  - {static} MAX_HINT_VALUE : double
  - {static} requireInRange(String, double)
}
class BiomeSizeRange <<record>> {
  + minWidthBlocks : int
  + maxWidthBlocks : int
}
class GrowthCohesionProfile <<record>> {
  + minSameBiomeNeighbors : int
  + directionalRunMajor : int
  + directionalRunMinor : int
  + {static} UNRESTRICTED : GrowthCohesionProfile
}
class ModBiomeGraph {
  - {static} DEFAULT_BLEND_WIDTH_BLOCKS : int
  - {static} COMPACT : GrowthCohesionProfile
  - {static} ELONGATED : GrowthCohesionProfile
  - {static} DESERT : BiomeId
  - {static} SAVANNA : BiomeId
  - {static} BADLANDS : BiomeId
  - {static} OCEAN : BiomeId
  - {static} FOREST : BiomeId
  - {static} PLAINS : BiomeId
  + {static} DEFAULT : BiomeGraph
}
class UnorderedBiomePair <<record>> {
  + first : BiomeId
  + second : BiomeId
  ~ {static} of(BiomeId, BiomeId) : UnorderedBiomePair
}

AdjacencyRule *--> BiomeId
AdjacencyRule ..> UnorderedBiomePair
BiomeGraph --> AdjacencyRule
BiomeGraph --> BiomeId
BiomeGraph --> BiomeNode
BiomeGraph --> UnorderedBiomePair
BiomeId ..|> Comparable
BiomeNode *--> BiomeFeatureToggles
BiomeNode *--> BiomeId
BiomeNode *--> BiomeShapeHints
BiomeNode *--> BiomeSizeRange
BiomeNode *--> GrowthCohesionProfile
ModBiomeGraph *--> GrowthCohesionProfile
UnorderedBiomePair *--> BiomeId

@enduml