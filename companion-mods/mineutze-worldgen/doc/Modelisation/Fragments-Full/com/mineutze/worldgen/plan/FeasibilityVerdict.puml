}
enum Outcome <<enum>> {
  PASS
  FAIL
  BORDERLINE
}
}

com.mineutze.worldgen.plan.FeasibilityVerdict *--> com.mineutze.worldgen.plan.Evidence
com.mineutze.worldgen.plan.FeasibilityVerdict *--> com.mineutze.worldgen.plan.Outcome