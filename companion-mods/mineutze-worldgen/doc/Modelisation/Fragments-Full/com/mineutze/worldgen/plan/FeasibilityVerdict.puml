  + outcome : Outcome
  + evidence : Evidence
  + worldFailureLowerBound : double
  + certifiedWorldFailureUpperBound : double
  + elapsed : Duration
  + rejection : Optional<String>
  + closestFailureReport : Optional<String>
  + renderFailureReport : Optional<String>
  - {static} CERTAIN_FAILURE : double
  - {static} PERCENT_PER_UNIT : double
  - {static} SMALLEST_SHOWN_PERCENT : double
  - {static} MILLIS_PER_SECOND : double
  - {static} RENDER_CAVEAT : String
  ~ {static} rejected(String, Duration) : FeasibilityVerdict
  + summary() : String
  - headline() : String
  - evidenceLine() : String
  - {static} percent(double) : String
