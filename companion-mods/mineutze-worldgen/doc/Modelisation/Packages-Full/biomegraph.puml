com.mineutze.worldgen.biomegraph.BiomeGraphJson ..> com.mineutze.worldgen.biomegraph.BiomeId
com.mineutze.worldgen.biomegraph.BiomeGraphJson ..> com.mineutze.worldgen.biomegraph.BiomeNode
com.mineutze.worldgen.biomegraph.BiomeGraphJson ..> com.mineutze.worldgen.biomegraph.BiomeSizeRange
com.mineutze.worldgen.biomegraph.BiomeGraphJson ..> com.mineutze.worldgen.biomegraph.EdgeData
com.mineutze.worldgen.biomegraph.BiomeGraphJson ..> com.mineutze.worldgen.biomegraph.GroupData
com.mineutze.worldgen.biomegraph.BiomeGraphJson ..> com.mineutze.worldgen.biomegraph.MinimalJson
com.mineutze.worldgen.biomegraph.BiomeGraphJson ..> com.mineutze.worldgen.biomegraph.NodeData
com.mineutze.worldgen.biomegraph.BiomeId ..|> Comparable
