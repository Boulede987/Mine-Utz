class com.mineutze.worldgen.plan.FeasibilityVerdict <<external>> [[plan.svg]] {
}
class com.mineutze.worldgen.plan.Outcome <<external>> [[plan.svg]] {
}
class com.mineutze.worldgen.plan.RankingUnavailable <<external>> [[plan.svg]] {
}
class com.mineutze.worldgen.plan.RawRuleTable <<external>> [[plan.svg]] {
