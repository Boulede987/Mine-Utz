@startuml graphedit

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

skinparam class {
  BackgroundColor<<external>> #EAECEE
  BorderColor<<external>> #839192
}

namespace com.mineutze.worldgen.tooling.graphedit {
class GraphEditorFiles {
  ~ {static} DATA_FILE : Path
}
class GraphEditorServer {
  - {static} DEFAULT_PORT : int
  + {static} main(String[])
}
class GraphEditorSolveCheck {
  - {static} WORLD_SEEDS : Long[*]
  + {static} main(String[])
  - {static} checkSeed(BiomeGraphData, int, long) : boolean
  - {static} secondsSince(long) : String
}
class GraphValidation {
  - {static} MIN_LEGAL_NEIGHBORS : int
  ~ {static} validate(BiomeGraphData) : ValidationResult
  - {static} generatorRejections(BiomeGraphData) : List<String>
  - {static} underConnectedErrors(BiomeGraph, BiomeGraphData) : List<String>
  - {static} checkConnectivity(BiomeGraph, List<BiomeId>, List<String>, BiomeId)
}
class ValidationResult <<record>> {
  + constructs : boolean
  + constructionError : String
  + errors : String[*]
}
}
class com.mineutze.worldgen.biomegraph.BiomeGraph <<external>> [[biomegraph.svg]] {
}
class com.mineutze.worldgen.biomegraph.BiomeGraphData <<external>> [[biomegraph.svg]] {
}
class com.mineutze.worldgen.biomegraph.BiomeGraphJson <<external>> [[biomegraph.svg]] {
}
class com.mineutze.worldgen.biomegraph.BiomeId <<external>> [[biomegraph.svg]] {
}
class com.mineutze.worldgen.plan.RawRuleTable <<external>> [[plan.svg]] {
}
class com.mineutze.worldgen.plan.WorldBiomePlan <<external>> [[plan.svg]] {
}

com.mineutze.worldgen.tooling.graphedit.GraphEditorServer ..> com.mineutze.worldgen.tooling.graphedit.GraphEditorFiles
com.mineutze.worldgen.tooling.graphedit.GraphEditorSolveCheck ..> com.mineutze.worldgen.biomegraph.BiomeGraphData
com.mineutze.worldgen.tooling.graphedit.GraphEditorSolveCheck ..> com.mineutze.worldgen.biomegraph.BiomeGraphJson
com.mineutze.worldgen.tooling.graphedit.GraphEditorSolveCheck ..> com.mineutze.worldgen.tooling.graphedit.GraphEditorFiles
com.mineutze.worldgen.tooling.graphedit.GraphEditorSolveCheck ..> com.mineutze.worldgen.plan.WorldBiomePlan
com.mineutze.worldgen.tooling.graphedit.GraphValidation ..> com.mineutze.worldgen.biomegraph.BiomeGraph
com.mineutze.worldgen.tooling.graphedit.GraphValidation ..> com.mineutze.worldgen.biomegraph.BiomeGraphData
com.mineutze.worldgen.tooling.graphedit.GraphValidation ..> com.mineutze.worldgen.biomegraph.BiomeGraphJson
com.mineutze.worldgen.tooling.graphedit.GraphValidation ..> com.mineutze.worldgen.biomegraph.BiomeId
com.mineutze.worldgen.tooling.graphedit.GraphValidation ..> com.mineutze.worldgen.plan.RawRuleTable
com.mineutze.worldgen.tooling.graphedit.GraphValidation ..> com.mineutze.worldgen.tooling.graphedit.ValidationResult
com.mineutze.worldgen.tooling.graphedit.GraphValidation ..> com.mineutze.worldgen.plan.WorldBiomePlan

@enduml