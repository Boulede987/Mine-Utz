@startuml

package "ITEMS" {
  class Item
  {
    name : string
    renewable : bool
    stackable : bool
  }

  class Tool
  {
    miningEfficiency : double
    miningLevel : int
    attackDamage : double
    attackSpeed : double
    attackRange : double
    durability : int
    enchantability : int
  }

  class Armor
  {
    armorPoints : double
    armorToughness : double
    durability : int
    enchantability : int
    knockbackResistance : double
  }

  class Food
  {
    hungerRestoration : int
    saturation : double
  }

  class Station
  {
  }

  class Recipe
  {
    name : string
    type : string
  }

  Station --|> Item
  Tool    --|> Item
  Armor   --|> Item
  Food    --|> Item

  Recipe "*" -- "*" Item : produces
  Recipe "*" -- "*" Item : uses as ingredient
  Recipe "*" -- "*" Station : made at
}

class Block
{
  namespace : string
  name : string
  blastResistance : double
  hardness : double
  luminous : bool
  transparent : bool
  flammable : bool
}

class Rarity
{
  tier : string
}

class LootTable
{
}

class Biome
{
  name : string
  mainColor : string
  temperature : float
}

class Structure
{
  name : string
}

class Dimension
{
  name : string
}

class Entity
{
  name : string
  behavior : string
  type : string
  healthPoints : double
  armorPoints : double
  attackDamage : double
  attackSpeed : double
  attackRange : double
  speed : double
  knockbackResistance : double
  weakness : string
  hitboxSize : double
  texture_b64 : string
}

class Mod
{
  namespace : string
  display_name : string
  version : string
}

class Licence
{
  name : string
}

class Author
{
  name : string
}

class Source
{
  site : string
  url : string
}

' ── Mod relations ─────────────────────────────────────────────────────────────
Mod "1" -- "1"    Licence   : has
Mod "1" -- "*"    Author    : developed by
Mod "1" -- "1..*" Source    : downloaded from
Mod "1" -- "*"    Entity    : adds
Mod "1" -- "*"    Item      : adds
Mod "1" -- "*"    Block     : adds
Mod "1" -- "*"    Biome     : adds
Mod "1" -- "*"    Structure : adds
Mod "1" -- "*"    Dimension : adds
Mod "1" -- "*"    Recipe    : adds

' ── Rarity ────────────────────────────────────────────────────────────────────
Rarity "1" -- "*" Item : defines

' ── World ─────────────────────────────────────────────────────────────────────
Dimension "*" -- "*" Biome     : contains
Structure "*" -- "*" Biome     : generates in

' ── Entities ──────────────────────────────────────────────────────────────────
Entity "*" -- "*" Biome : spawns in
class BiomeSpawnTable
{
  weight : int
  minCount : int
  maxCount : int
}
(Entity, Biome) .. BiomeSpawnTable

Entity "*" -- "*" Dimension : spawns in
Entity "*" -- "*" Structure  : spawns in

' ── Blocks in world ───────────────────────────────────────────────────────────
Block "*" -- "*" Biome     : generates in
Block "*" -- "*" Structure : generates in
class BlockStructureGenerationTable
{
  number : int
}
(Block, Structure) .. BlockStructureGenerationTable

' ── Loot ──────────────────────────────────────────────────────────────────────
LootTable "*" -- "*" Structure : found in
LootTable "*" -- "*" Entity    : dropped by
LootTable "*" -- "*" LootTable : references
LootTable "*" -- "*" Item      : comprises
class Comprises
{
  minNumber : int
  maxNumber : int
  weight : int
}
(LootTable, Item) .. Comprises

Block "*" -- "*" LootTable : drops

@enduml
