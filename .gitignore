# ===========================
# Minecraft Instance
# Ignore everything, whitelist what matters
# ===========================
minecraft/*

# --- Core pack files ---
!minecraft/mods/
minecraft/mods/*
!minecraft/mods/*.pw.toml
!minecraft/mods/.index
!minecraft/mods/index.toml

!minecraft/config/
!minecraft/defaultconfigs/
!minecraft/kubejs/
!minecraft/scripts/
!minecraft/resources/

# --- FTB Quests (nested whitelist) ---
!minecraft/local/
minecraft/local/*
!minecraft/local/ftbquests/
minecraft/local/ftbquests/*
!minecraft/local/ftbquests/quests/

# ===========================
# Prism Launcher
# ===========================
instance.cfg
mmc-pack.json
lastlaunch
.curseclient
.ccinstances

# ===========================
# Packwiz
# ===========================
packwiz-installer*
.packwiz/

# Keep packwiz root files
!pack.toml
!index.toml

# ===========================
# Manifests
# ===========================
!manifest.json
!modrinth.index.json

# ===========================
# OS Files
# ===========================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.directory

# ===========================
# Development Files
# ===========================
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# ===========================
# Temporary & Performance Files
# ===========================
*.tmp
*.temp
*.bak
*.backup
*.hprof
*.prof

# ===========================
# Documentation (keep)
# ===========================
!README.md
!CONTRIBUTING.md
!CHANGELOG.md
!LICENSE