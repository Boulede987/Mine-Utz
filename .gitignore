# ===========================
# Packwiz mod metadata (root level)
# Keep .pw.toml files, block any stray jars
# ===========================
mods/*.jar
mods/*.jar.disabled
mods/*.zip
mods/*.disabled
mods/*.litemod

# ===========================
# Minecraft instance
# Ignore everything, whitelist what matters
# ===========================
minecraft/*

# --- Packwiz mod index ---
!minecraft/mods/
minecraft/mods/*
!minecraft/mods/.index
!minecraft/mods/index.toml
!minecraft/mods/*.pw.toml

# --- Config & scripts ---
!minecraft/config/
!minecraft/defaultconfigs/
!minecraft/kubejs/
!minecraft/resources/

# --- FTB Quests (nested whitelist) ---
!minecraft/local/
minecraft/local/*
!minecraft/local/ftbquests/
minecraft/local/ftbquests/*
!minecraft/local/ftbquests/quests/

# --- Journeymap config only (not map data) ---
!minecraft/journeymap/
minecraft/journeymap/*
!minecraft/journeymap/config/

# --- Coremods (NeoForge needs these) ---
!minecraft/coremods/

# --- Cobblenav settings ---
!minecraft/cobblenav/
minecraft/cobblenav/*
!minecraft/cobblenav/settings/

# ===========================
# Root level resource packs
# ===========================
resourcepacks/*
!resourcepacks/CUSTOM_*.zip
!resourcepacks/README.md

# ===========================
# Release folder (keep exports)
# ===========================
release/*
!release/*.mrpack
!release/README.md

# ===========================
# Prism Launcher
# ===========================
instance.cfg
mmc-pack.json
lastlaunch
.curseclient
.ccinstances

# ===========================
# Packwiz root files (keep)
# ===========================
packwiz-installer*
.packwiz/
!pack.toml
!index.toml

# ===========================
# Manifests (keep)
# ===========================
!manifest.json
!modrinth.index.json

# ===========================
# OS Files
# ===========================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.directory

# ===========================
# Development Files
# ===========================
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# ===========================
# Temporary & Performance Files
# ===========================
*.tmp
*.temp
*.bak
*.backup
*.hprof
*.prof

# ===========================
# Documentation (keep)
# ===========================
!README.md
!CONTRIBUTING.md
!CHANGELOG.md
!LICENSE